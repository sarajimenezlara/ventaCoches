<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Editar coche</title>
    </head>
    <body>
        <nav>
            <a href="index.php">Inicio</a>
            <a href="index.php?c=coche&action=list">Coches</a>
            <a href="index.php?c=coche&action=create">Nuevo coche</a>
            <a href="index.php?c=user&action=logout">Cerrar sesión</a>
        </nav>
        <main>
            <h1>Editar coche</h1>

            <?php if (!empty($error)): ?>
                <p><?= htmlspecialchars($error) ?></p>
            <?php endif; ?>

            <!-- La situación no se cambia aquí: la cambian las reservas y las ventas -->
            <p>Situación: <?= htmlspecialchars(ucfirst($coche->getSituacion())) ?></p>

            <?php
            // Si se acaba de enviar el formulario con algún error se enseña lo que escribieron;
            // si no, los datos que tiene ahora el coche
            $combustible = $_POST['combustible'] ?? $coche->getCombustible();
            ?>
            <!-- enctype para poder subir la foto -->
            <form method="POST" action="index.php?c=coche&action=edit&id=<?= (int)$coche->getId() ?>" enctype="multipart/form-data">
                <label for="matricula">Matrícula:</label>
                <input type="text" id="matricula" name="matricula" maxlength="15" value="<?= htmlspecialchars($_POST['matricula'] ?? $coche->getMatricula()) ?>" required>

                <label for="marca">Marca:</label>
                <input type="text" id="marca" name="marca" maxlength="100" value="<?= htmlspecialchars($_POST['marca'] ?? $coche->getMarca()) ?>" required>

                <label for="modelo">Modelo:</label>
                <input type="text" id="modelo" name="modelo" maxlength="100" value="<?= htmlspecialchars($_POST['modelo'] ?? $coche->getModelo()) ?>" required>

                <label for="anio">Año:</label>
                <input type="number" id="anio" name="anio" min="1950" max="<?= date('Y') ?>" value="<?= htmlspecialchars($_POST['anio'] ?? $coche->getAnio()) ?>" required>

                <label for="kilometros">Kilómetros:</label>
                <input type="number" id="kilometros" name="kilometros" min="0" value="<?= htmlspecialchars($_POST['kilometros'] ?? $coche->getKilometros()) ?>" required>

                <label for="color">Color:</label>
                <input type="text" id="color" name="color" maxlength="50" value="<?= htmlspecialchars($_POST['color'] ?? $coche->getColor() ?? '') ?>">

                <label for="combustible">Combustible:</label>
                <select id="combustible" name="combustible">
                    <?php foreach (['gasolina' => 'Gasolina', 'diesel' => 'Diésel', 'hibrido' => 'Híbrido', 'electrico' => 'Eléctrico'] as $valor => $texto): ?>
                        <option value="<?= $valor ?>" <?= $combustible === $valor ? 'selected' : '' ?>><?= $texto ?></option>
                    <?php endforeach; ?>
                </select>

                <label for="precio_venta">Precio de venta (€):</label>
                <input type="number" id="precio_venta" name="precio_venta" min="0" step="0.01" value="<?= htmlspecialchars($_POST['precio_venta'] ?? $coche->getPrecioVenta()) ?>" required>

                <label for="descripcion">Descripción:</label>
                <textarea id="descripcion" name="descripcion" rows="3"><?= htmlspecialchars($_POST['descripcion'] ?? $coche->getDescripcion() ?? '') ?></textarea>

                <p>Foto actual:</p>
                <?php if ($coche->getImagen()): ?>
                    <img src="public/image/<?= htmlspecialchars($coche->getImagen()) ?>" alt="<?= htmlspecialchars($coche->getMarca() . ' ' . $coche->getModelo()) ?>" width="200">
                <?php else: ?>
                    <p>Sin foto</p>
                <?php endif; ?>

                <label for="imagen">Cambiar foto (si no eliges ninguna, se queda la actual):</label>
                <input type="file" id="imagen" name="imagen" accept="image/jpeg,image/png,image/webp">

                <input type="submit" value="Guardar cambios">
            </form>

            <p><a href="index.php?c=coche&action=list">Volver al listado de coches</a></p>
        </main>
    </body>
</html>
