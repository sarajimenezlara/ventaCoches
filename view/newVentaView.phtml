<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Vender coche</title>
    </head>
    <body>
        <nav>
            <a href="index.php">Inicio</a>
            <a href="index.php?c=coche&action=list">Coches</a>
            <a href="index.php?c=cliente&action=list">Clientes</a>
            <a href="index.php?c=compra&action=create">Registrar compra</a>
            <a href="index.php?c=reserva&action=list">Reservas</a>
            <a href="index.php?c=user&action=logout">Cerrar sesión</a>
        </nav>
        <main>
            <h1>Vender coche</h1>
            <h2><?= htmlspecialchars($coche->getMarca() . ' ' . $coche->getModelo()) ?> (<?= htmlspecialchars($coche->getMatricula()) ?>)</h2>
            <p>Precio de venta anunciado: <?= number_format($coche->getPrecioVenta(), 2, ',', '.') ?> €</p>

            <?php if (!empty($error)): ?>
                <p><?= htmlspecialchars($error) ?></p>
            <?php endif; ?>

            <form method="POST" action="index.php?c=venta&action=create">
                <input type="hidden" name="id_coche" value="<?= (int)$coche->getId() ?>">

                <?php if ($reserva): ?>
                    <!-- Reservado: se vende al cliente que lo reservó -->
                    <input type="hidden" name="tiene_reserva" value="1">
                    <p>Reservado por: <?= $clienteReserva ? htmlspecialchars(trim($clienteReserva->getNombre() . ' ' . ($clienteReserva->getApellidos() ?? '')) . ' (' . $clienteReserva->getDni() . ')') : '' ?></p>
                <?php else: ?>
                    <label for="id_cliente">Comprador:</label>
                    <select id="id_cliente" name="id_cliente" required>
                        <option value="">-- Elige un cliente --</option>
                        <?php foreach ($clientes as $cliente): ?>
                            <option value="<?= (int)$cliente->getId() ?>" <?= (int)($_POST['id_cliente'] ?? 0) === $cliente->getId() ? 'selected' : '' ?>>
                                <?= htmlspecialchars(trim($cliente->getNombre() . ' ' . ($cliente->getApellidos() ?? ''))) ?> (<?= htmlspecialchars($cliente->getDni()) ?>)
                            </option>
                        <?php endforeach; ?>
                    </select>
                    <p>¿No está? <a href="index.php?c=cliente&action=create">Da de alta al cliente</a>.</p>
                <?php endif; ?>

                <label for="precio">Precio final (€):</label>
                <input type="number" id="precio" name="precio" min="0" step="0.01" value="<?= htmlspecialchars($_POST['precio'] ?? $coche->getPrecioVenta()) ?>" required>

                <label for="metodo_pago">Método de pago:</label>
                <select id="metodo_pago" name="metodo_pago">
                    <?php foreach (['efectivo' => 'Efectivo', 'tarjeta' => 'Tarjeta', 'transferencia' => 'Transferencia'] as $valor => $texto): ?>
                        <option value="<?= $valor ?>" <?= ($_POST['metodo_pago'] ?? '') === $valor ? 'selected' : '' ?>><?= $texto ?></option>
                    <?php endforeach; ?>
                </select>

                <input type="submit" value="Confirmar venta">
            </form>

            <p><a href="index.php?c=coche&action=list">Volver a los coches</a></p>
        </main>
    </body>
</html>
